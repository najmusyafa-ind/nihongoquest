# NihongoQuest Environment Variables
# Copy this file to .env.local and fill in your values
# Add ALL variables below to Vercel: Settings → Environment Variables

# ── Site URL ──────────────────────────────────────────────────────────────────
# Production: set to your actual Vercel domain, e.g. https://nihongoquest.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, NEVER expose to browser / client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (Drizzle ORM) ────────────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string
# Use "Transaction mode" with port 6543 (required for Drizzle + Supabase pooler)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Upstash Redis (Rate Limiting — REQUIRED for production) ───────────────────
# Without this, rate limiting falls back to in-memory (not effective on Vercel).
# Setup (free, 2 minutes):
#   1. Go to https://upstash.com → Sign Up (use GitHub login)
#   2. Create Database → Region: ap-southeast-1 (Singapore) or ap-northeast-1 (Tokyo)
#   3. Copy REST URL and REST Token from the database dashboard
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ── Sentry Error Monitoring (REQUIRED for production) ─────────────────────────
# Without this, errors in production are invisible.
# Setup (free up to 5k errors/month, 2 minutes):
#   1. Go to https://sentry.io → Sign Up
#   2. Create Project → Platform: Next.js
#   3. Copy DSN from: Settings → Projects → [your project] → Client Keys (DSN)
#   4. Create Auth Token: User Settings → Auth Tokens → Create New Token
# Docs: docs/error-monitoring.md
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/your-project-id
SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/your-project-id
SENTRY_AUTH_TOKEN=sntrys_your-auth-token-here
